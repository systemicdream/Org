<component type="desktop-application">
  <id>io.github.systemicdream.Aster</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Aster</name>
  <summary>Notes, to-dos and plans in plain Org files</summary>
  <description>
    <p>
      Aster is a notes app built on Org mode, without needing to learn Emacs. Your notes are
      plain .org files in a folder you choose: open them in any editor, and sync them with
      any service you like.
    </p>
    <ul>
      <li>Headings, lists, checkboxes, tables and links, formatted as you type</li>
      <li>Tasks with dates and deadlines, and an agenda of your day and week</li>
      <li>Quick capture, refile and archive across your notes folder</li>
      <li>Optional Emacs and Vim keys</li>
    </ul>
    <p>Aster is in early development: expect rough edges.</p>
  </description>
  <launchable type="desktop-id">io.github.systemicdream.Aster.desktop</launchable>
